# Ollama Configuration for Sanitizer Pipeline

# Model to use (must be pulled first: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:7b-instruct

# Temperature (0 = deterministic, 1 = creative)
# For anonymization, we want deterministic output
OLLAMA_TEMPERATURE=0

# Optional: Maximum tokens to generate
# OLLAMA_NUM_PREDICT=2000

# Optional: Context window size
# OLLAMA_NUM_CTX=4096

# Usage:
# Source this file before running pipeline:
#   source config/ollama.env
#   ./scripts/pipeline.sh data/input/sample.txt
